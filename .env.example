# Copy to .env in this directory. Keep real credentials out of Git.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TEMPERATURE=0.7
OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
OLLAMA_MODEL_INTENT=minimax-m3

# Change FRONTEND_PORT to 5001 if macOS AirPlay uses port 5000.
BACKEND_PORT=8080
FRONTEND_PORT=5000

# Optional tracing. Set both keys to enable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
